      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (rate(opensearch_indices_indexing_index_count[$__rate_interval]))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
