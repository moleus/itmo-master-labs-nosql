extends: default
rules:
  line-length:
    max: 200          # длинные PromQL-выражения в lab_metrics
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false # ключ "on:" в GitHub Actions
  comments:
    min-spaces-from-content: 1
  comments-indentation: false   # требование ansible-lint
  document-start: disable
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
ignore: |
  .vagrant/
