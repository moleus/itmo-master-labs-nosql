# {{ ansible_managed }}
global:
  scrape_interval: 10s
scrape_configs:
  - job_name: mongodb
    static_configs:
      - targets: ["127.0.0.1:9216"]
        labels: { instance: "{{ inventory_hostname }}" }
  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:9100"]
        labels: { instance: "{{ inventory_hostname }}" }
  - job_name: victoriametrics
    static_configs:
      - targets: ["127.0.0.1:8428"]
