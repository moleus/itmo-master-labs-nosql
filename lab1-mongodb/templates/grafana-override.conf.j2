# Настройки Grafana через переменные окружения.
[Service]
Environment=GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
Environment=GF_AUTH_ANONYMOUS_ENABLED=true
Environment=GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
Environment=GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/mongodb-lab.json
