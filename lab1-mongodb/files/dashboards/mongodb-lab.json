    "textMode": "value"
   }
  },
  {
   "type": "row",
   "title": "Операции и запросы",
   "id": 8,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Операции по типам (opcounters)",
   "description": "serverStatus.opcounters: сколько команд пришло. insert считается по документам: insertMany из 100 документов даёт +100.",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(mongodb_ss_opcounters{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "{{legacy_op_type}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Документы (metrics.document)",
   "description": "Сколько документов вставлено, возвращено, изменено, удалено. Отличие от opcounters: здесь документы, а не команды.",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(mongodb_ss_metrics_document{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "{{doc_op_type}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Эффективность запросов",
   "description": "Сколько документов и ключей индекса прочитано на 1 возвращённый документ. Около 1 = запросы идут по индексу. Сильно больше 1 = COLLSCAN или плохой индекс.",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(mongodb_ss_metrics_queryExecutor_scannedObjects{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(mongodb_ss_metrics_document{job=~\"$job\",instance=~\"$instance\",doc_op_type='returned'}[$__rate_interval])), 1)",
     "legendFormat": "scanned docs / returned",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(mongodb_ss_metrics_queryExecutor_scanned{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(mongodb_ss_metrics_document{job=~\"$job\",instance=~\"$instance\",doc_op_type='returned'}[$__rate_interval])), 1)",
     "legendFormat": "scanned keys / returned",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Средняя задержка операций",
   "description": "opLatencies: суммарное время / число операций за минуту, в миллисекундах. Время внутри mongod, без сети.",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(mongodb_ss_opLatencies_latency{job=~\"$job\",instance=~\"$instance\",op_type!='transactions'}[$__rate_interval]) / clamp_min(rate(mongodb_ss_opLatencies_ops{job=~\"$job\",instance=~\"$instance\",op_type!='transactions'}[$__rate_interval]), 1) / 1000",
     "legendFormat": "{{op_type}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Полные сканы коллекций",
   "description": "queryExecutor.collectionScans: запросы без индекса. Каждый такой запрос читает всю коллекцию.",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(mongodb_ss_metrics_queryExecutor_collectionScans_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "collection scans/s",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Операции по коллекциям",
   "description": "collStats.latencyStats: чтения и записи по каждой коллекции.",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(mongodb_collstats_latencyStats_reads_ops{job=~\"$job\",instance=~\"$instance\",database='shop'}[$__rate_interval])",
     "legendFormat": "read {{collection}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(mongodb_collstats_latencyStats_writes_ops{job=~\"$job\",instance=~\"$instance\",database='shop'}[$__rate_interval])",
     "legendFormat": "write {{collection}}",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "WiredTiger: кэш, тикеты, диск",
   "id": 15,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 22
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Кэш WiredTiger, % от размера",
   "description": "Заполнение кэша и доля грязных (изменённых, ещё не записанных) страниц. Пороги WiredTiger: при 80% заполнения фоновые потоки начинают вытеснение, при 95% вытеснять начинают потоки клиентов (запросы замедляются). Для грязных: 5% и 20%.",
   "id": 16,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 23
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "100 * mongodb_ss_wt_cache_bytes_currently_in_the_cache{job=~\"$job\",instance=~\"$instance\"} / mongodb_ss_wt_cache_maximum_bytes_configured{job=~\"$job\",instance=~\"$instance\"}",
     "legendFormat": "used %",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "100 * mongodb_ss_wt_cache_tracked_dirty_bytes_in_the_cache{job=~\"$job\",instance=~\"$instance\"} / mongodb_ss_wt_cache_maximum_bytes_configured{job=~\"$job\",instance=~\"$instance\"}",
     "legendFormat": "dirty %",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 5,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "yellow",
        "value": 80
       },
       {
        "color": "red",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Страницы: чтение в кэш, запись, вытеснение",
   "description": "pages read into cache = чтение с диска (кэш промахнулся). written from cache = запись на диск. evicted = страницы, выброшенные из кэша.",
   "id": 17,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 23
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(mongodb_ss_wt_cache_pages_read_into_cache{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "read into cache",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "rate(mongodb_ss_wt_cache_pages_written_from_cache{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])",
     "legendFormat": "written from cache",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
