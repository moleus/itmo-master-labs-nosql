   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Операций/с",
   "description": "Сумма opcounters по всем типам за минуту.",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(mongodb_ss_opcounters{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))",
     "refId": "A",
     "instant": true,
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Данные shop",
   "description": "dbStats.dataSize базы shop: несжатый размер документов.",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "mongodb_dbstats_dataSize{job=~\"$job\",instance=~\"$instance\",database='shop'}",
     "refId": "A",
     "instant": true,
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
